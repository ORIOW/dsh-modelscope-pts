{
  "name": "dsh-modelscope-pts",
  "version": "0.4.0",
  "private": false,
  "type": "module",
  "description": "在 DeepSeek Harness 的模型选择器与插件管理页实时显示 ModelScope 账号的剩余魔粒（积分）余额：访问令牌优先、失败回退会话 Cookie；附带每日魔粒互动组件（modelscope-magicube）：定时为未星标的模型点赞领取魔粒、运行时自动打开浏览器领登录奖励、按周期探测已添加模型的可用性，运行或探测结束后以浮窗小卡提示结果（凭据全部失效时强提醒）；插件实现无需 Python。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "modelscope",
    "magicubes",
    "points",
    "quota"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./magicube": {
      "default": "./lib/magicube.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./magicube/locale/*.json": "./magicube/locale/*.json",
    "./icon": "./icon.svg",
    "./magicube/icon": "./magicube/icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "magicube"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "*",
    "react": "^18.2.0"
  }
}
